---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Giscus from '../components/Giscus.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'posts'>['data'];

const { title, description, pubDate, updatedDate, tags, handwritten, llms, comments, heroImage, ogImage } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={ogImage?.src ?? heroImage?.src} />
	</head>
	<body>
		<Header />
		<main id="main" class="page-grid">
			<header class="page-title">
				<h1>{title}</h1>
			</header>
			<aside class="page-meta">
				<div class="meta-date">
					<FormattedDate date={pubDate} />
					{updatedDate && (
						<div class="updated">
							Updated <FormattedDate date={updatedDate} />
						</div>
					)}
				</div>
				{handwritten ? (
					<span class="badge handwritten">handwritten</span>
				) : (
					<div class="ai-disclosure" aria-label="AI assistance disclosure">
						<div class="ai-disclosure-header">AI-assisted</div>
						{llms.length > 0 && (
							<ul class="llm-list" aria-label="LLMs used">
								{llms.map((llm) => (
									<li><span class="llm-chip">{llm}</span></li>
								))}
							</ul>
						)}
					</div>
				)}
				{tags && tags.length > 0 && (
					<ul class="tags">
						{tags.map((tag) => (
							<li><a href={`/tag/${tag}/`} class="tag">#{tag}</a></li>
						))}
					</ul>
				)}
			</aside>
			<div class="page-body">
				<article>
					{heroImage && (
						<img src={heroImage.src} alt="" class="hero-image" width={heroImage.width} height={heroImage.height} />
					)}
					<div class="prose">
						<slot />
					</div>
				</article>
				{comments && (
					<section class="comments">
						<Giscus />
					</section>
				)}
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-title h1 {
		margin-bottom: 0;
	}

	.page-title {
		margin-bottom: 2rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--color-rule);
	}

	.page-meta {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--color-ink-3);
		margin-bottom: 2rem;
	}

	.meta-date {
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-ink-3);
	}

	.meta-date :global(time) {
		color: var(--color-ink-2);
	}

	.updated {
		margin-top: 0.25rem;
	}

	.tags {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.tag {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-ink-3);
		text-decoration: none;
		padding: 0.1rem 0.5rem;
		border: 1px solid var(--color-rule);
		border-radius: 2px;
		transition: color 0.15s ease, border-color 0.15s ease;
	}

	.tag:hover,
	.tag:focus-visible {
		color: var(--color-accent);
		border-color: var(--color-accent);
		text-decoration: none;
	}

	.badge {
		display: inline-block;
		align-self: flex-start;
		padding: 0.05rem 0.4rem;
		border-radius: 2px;
		border: 1px solid var(--color-rule-2);
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 500;
		line-height: 1.5;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-ink-3);
		background: transparent;
	}

	.handwritten {
		color: var(--color-accent);
		border-color: var(--color-accent);
	}

	.ai-disclosure {
		display: inline-flex;
		flex-direction: column;
		align-self: flex-start;
		max-width: 100%;
		border: 1px solid var(--color-rule);
		border-radius: 2px;
		overflow: hidden;
		color: var(--color-ink-3);
	}

	.ai-disclosure-header {
		padding: 0.3rem 0.625rem;
		border-bottom: 1px solid var(--color-rule);
		font-size: 0.6875rem;
		font-weight: 500;
		line-height: 1.4;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.llm-list {
		list-style: none;
		margin: 0;
		padding: 0.45rem 0.5rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}

	.llm-chip {
		display: inline-block;
		padding: 0.1rem 0.45rem;
		border: 1px solid color-mix(in srgb, var(--color-accent) 35%, transparent);
		border-radius: 999px;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 500;
		line-height: 1.3;
		letter-spacing: 0.02em;
		color: var(--color-accent);
		background: color-mix(in srgb, var(--color-accent) 7%, transparent);
	}

	.hero-image {
		width: 100%;
		height: auto;
		border: 1px solid var(--color-rule);
		border-radius: 3px;
		margin-bottom: 2rem;
	}

	/* Widescreen: meta rail layout tweaks */
	@media (min-width: 1024px) {
		.page-title {
			margin-bottom: 2.5rem;
			padding-bottom: 1.5rem;
			/* the spine border on .page-title already provides the left rule */
		}

		.page-meta {
			align-items: flex-start;
			gap: 1.25rem;
			margin-bottom: 0;
		}

		.tags {
			flex-direction: column;
			gap: 0.4rem;
		}

		.ai-disclosure {
			width: 100%;
		}

		.tag {
			border: none;
			padding: 0;
		}

		.tag:hover,
		.tag:focus-visible {
			border: none;
		}
	}

	.comments {
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid var(--color-rule);
	}
</style>
