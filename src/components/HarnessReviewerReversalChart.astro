---

<div class="chart-container">
  <div class="chart-header">
    <div class="chart-title">Reviewer accept rate, excursion runs</div>
    <div class="chart-subtitle">Share of reviewer-raised issues the evaluator accepted as real</div>
  </div>
  <canvas id="harness-reviewer-reversal-chart"></canvas>
</div>

<script>
  import { mountThemedChart } from '../lib/chart-theme';

  const labels = ['Run 4', 'Run 5'];

  mountThemedChart('harness-reviewer-reversal-chart', (t) => ({
    type: 'line',
    data: {
      labels,
      datasets: [
        {
          label: 'pi',
          data: [57, 33],
          borderColor: t.accent,
          backgroundColor: t.accent,
          tension: 0,
          pointRadius: 6,
          pointHoverRadius: 8,
          borderWidth: 3,
        },
        {
          label: 'claude-sdk',
          data: [28, 62],
          borderColor: t.amber,
          backgroundColor: t.amber,
          tension: 0,
          pointRadius: 6,
          pointHoverRadius: 8,
          borderWidth: 3,
        },
      ],
    },
    options: {
      responsive: true,
      maintainAspectRatio: true,
      aspectRatio: 2.2,
      plugins: {
        legend: {
          position: 'bottom',
          labels: {
            color: t.tick,
            usePointStyle: true,
            pointStyle: 'circle',
            padding: 20,
            font: { size: 12 },
          },
        },
        tooltip: {
          callbacks: {
            label: (context) => `${context.dataset.label}: ${context.parsed.y}%`,
          },
        },
      },
      scales: {
        x: {
          grid: { display: false },
          ticks: { color: t.tick, font: { size: 12 } },
        },
        y: {
          grid: { color: t.grid },
          ticks: {
            color: t.tick,
            callback: (value) => `${value}%`,
            font: { size: 11 },
          },
          beginAtZero: true,
          suggestedMax: 80,
        },
      },
    },
  }));
</script>
