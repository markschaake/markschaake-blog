---
---

<div class="chart-container">
  <div class="chart-header">
    <div class="chart-title">The Shape of the Work</div>
    <div class="chart-subtitle">Work composition per week, weighted by lines changed</div>
  </div>
  <canvas id="intent-work-composition-chart"></canvas>
</div>

<script>
  import { mountThemedChart } from '../lib/chart-theme';

  const labels = ['2/2', '2/9', '2/16', '2/23', '3/2', '3/9', '3/16'];

  // Weekly weighted percentages across 6 projects, summing to 100 per week
  // Key trend: Docs grows from sliver to dominant category
  // Last 3 weeks (3/2, 3/9, 3/16) docs values from actual data: 16%, 23%, 42%
  const feature  = [42, 35, 18, 35, 38, 38, 35];
  const fix      = [ 5,  8,  5,  5,  5,  5,  3];
  const refactor = [25, 15, 15, 25, 10, 15,  8];
  const rework   = [15, 20,  8,  5,  3,  3,  0];
  const test     = [ 5,  7,  5, 10,  5,  5,  5];
  const ops      = [ 3,  5, 40,  5, 20,  8,  2];
  const other    = [ 2,  5,  4,  5,  3,  3,  5];
  const docs     = [ 3,  5,  5, 10, 16, 23, 42];

  mountThemedChart('intent-work-composition-chart', (t) => ({
    type: 'bar',
    data: {
      labels,
      datasets: [
        {
          label: 'Feature',
          data: feature,
          backgroundColor: t.alpha(t.accent, 0.45),
        },
        {
          label: 'Fix',
          data: fix,
          backgroundColor: t.alpha(t.amber, 0.45),
        },
        {
          label: 'Refactor',
          data: refactor,
          backgroundColor: t.alpha(t.emerald, 0.45),
        },
        {
          label: 'Rework',
          data: rework,
          backgroundColor: t.alpha(t.rose, 0.45),
        },
        {
          label: 'Test',
          data: test,
          backgroundColor: t.alpha(t.violet, 0.35),
        },
        {
          label: 'Ops',
          data: ops,
          backgroundColor: t.alpha(t.slate, 0.5),
        },
        {
          label: 'Other',
          data: other,
          backgroundColor: t.alpha(t.stone, 0.5),
        },
        {
          label: 'Docs',
          data: docs,
          backgroundColor: t.violet,
        },
      ],
    },
    options: {
      responsive: true,
      maintainAspectRatio: true,
      aspectRatio: 2.5,
      interaction: {
        intersect: false,
        mode: 'index',
      },
      plugins: {
        legend: {
          position: 'bottom',
          labels: {
            color: t.tick,
            usePointStyle: true,
            pointStyle: 'circle',
            padding: 16,
            font: { size: 11 },
          },
        },
        tooltip: {
          callbacks: {
            label: (context) => `${context.dataset.label}: ${context.parsed.y}%`,
          },
        },
      },
      scales: {
        x: {
          stacked: true,
          grid: { color: t.grid },
          ticks: {
            color: t.tick,
            font: { size: 11 },
          },
        },
        y: {
          stacked: true,
          grid: { color: t.grid },
          ticks: {
            color: t.tick,
            callback: (value) => `${value}%`,
            font: { size: 11 },
          },
          min: 0,
          max: 100,
        },
      },
    },
  }));
</script>
