---
---

<div class="chart-container">
  <div class="chart-header">
    <div class="chart-title">Two Rework Signals, One Timeline</div>
    <div class="chart-subtitle">File-level churn vs. classified rework, weekly</div>
  </div>
  <canvas id="churn-vs-reported-chart"></canvas>
</div>

<script>
  import { mountThemedChart } from '../lib/chart-theme';

  // Illustrative data: ~13 weeks of patterns reflecting real dashboard variance
  // File rework spikes during refactor-heavy weeks (W1, W3, W7, W12) because
  // churn sees re-edited files. Classified rework stays low because the classifier
  // correctly identifies refactoring as refactoring, not rework. The divergence
  // is the argument.
  const labels = [
    'W1', 'W2', 'W3', 'W4', 'W5', 'W6', 'W7',
    'W8', 'W9', 'W10', 'W11', 'W12', 'W13',
  ];

  // Machine:wall ratio - trending upward with noise
  const ratioData = [
    1.1, 1.2, 1.15, 1.3, 1.35, 1.4, 1.35,
    1.5, 1.55, 1.6, 1.55, 1.3, 1.65,
  ];

  // File-level churn - spikes align with refactor-heavy weeks in composition chart
  const churnData = [
    35, 12, 28, 8, 10, 14, 32,
    8, 10, 12, 10, 55, 18,
  ];

  // Classified rework - tracks actual rework, not fooled by refactoring
  const classifiedRework = [
    12, 16, 8, 12, 8, 12, 8,
    6, 8, 6, 8, 4, 6,
  ];

  mountThemedChart('churn-vs-reported-chart', (t) => ({
    type: 'line',
    data: {
      labels,
      datasets: [
        {
          label: 'Machine:Wall Ratio',
          data: ratioData,
          borderColor: t.accent,
          backgroundColor: t.alpha(t.accent, 0.1),
          fill: false,
          tension: 0.3,
          pointRadius: 0,
          pointHoverRadius: 3,
          borderWidth: 2,
          spanGaps: true,
          yAxisID: 'y',
        },
        {
          label: 'File Rework (churn)',
          data: churnData,
          borderColor: t.rose,
          backgroundColor: t.alpha(t.rose, 0.1),
          fill: false,
          tension: 0.3,
          pointRadius: 0,
          pointHoverRadius: 3,
          borderWidth: 2,
          spanGaps: true,
          yAxisID: 'y1',
        },
        {
          label: 'Classified Rework',
          data: classifiedRework,
          borderColor: t.violet,
          backgroundColor: t.alpha(t.violet, 0.1),
          fill: false,
          tension: 0.3,
          pointRadius: 2,
          pointHoverRadius: 4,
          borderWidth: 2,
          spanGaps: true,
          yAxisID: 'y1',
        },
        {
          label: 'Baseline (1.0)',
          data: Array(labels.length).fill(1.0),
          borderColor: t.amber,
          borderDash: [6, 4],
          borderWidth: 1,
          pointRadius: 0,
          pointHoverRadius: 0,
          fill: false,
          yAxisID: 'y',
        },
      ],
    },
    options: {
      responsive: true,
      maintainAspectRatio: true,
      aspectRatio: 2.5,
      interaction: {
        intersect: false,
        mode: 'index',
      },
      plugins: {
        legend: {
          position: 'bottom',
          labels: {
            color: t.tick,
            usePointStyle: true,
            pointStyle: 'circle',
            padding: 20,
            font: { size: 12 },
            filter: (item) => item.text !== 'Baseline (1.0)',
          },
        },
        tooltip: {
          filter: (item) => item.dataset.label !== 'Baseline (1.0)',
          callbacks: {
            label: (context) => {
              if (context.dataset.yAxisID === 'y1') {
                return `${context.dataset.label}: ${context.parsed.y}%`;
              }
              return `${context.dataset.label}: ${context.parsed.y}x`;
            },
          },
        },
      },
      scales: {
        x: {
          grid: { color: t.grid },
          ticks: {
            color: t.tick,
            maxRotation: 0,
            font: { size: 11 },
          },
        },
        y: {
          position: 'left',
          grid: { color: t.grid },
          ticks: {
            color: t.accent,
            callback: (value) => `${value}x`,
            font: { size: 11 },
          },
          min: 0.8,
          suggestedMax: 2.0,
        },
        y1: {
          position: 'right',
          grid: { drawOnChartArea: false },
          ticks: {
            color: t.rose,
            callback: (value) => `${value}%`,
            font: { size: 11 },
          },
          min: 0,
          suggestedMax: 65,
        },
      },
    },
  }));
</script>
