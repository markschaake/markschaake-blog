---
---

<div class="chart-container">
  <div class="chart-header">
    <div class="chart-title">Machine:Wall Ratio</div>
    <div class="chart-subtitle">7-day trailing ratio (active days only)</div>
  </div>
  <canvas id="machine-wall-ratio-chart"></canvas>
</div>

<script>
  import { mountThemedChart } from '../lib/chart-theme';

  const labels = [
    '1/11', '1/12', '1/13', '1/14', '1/15', '1/16', '1/17', '1/18',
    '1/19', '1/20', '1/21', '1/22', '1/23', '1/24', '1/25', '1/26',
    '1/27', '1/28', '1/29', '1/30', '1/31', '2/1', '2/2', '2/3',
    '2/4', '2/5', '2/6', '2/7', '2/8', '2/9', '2/10', '2/11',
    '2/12', '2/13', '2/14', '2/15', '2/16', '2/17', '2/18', '2/19',
  ];

  const wallHours = [
    0.5, 0, 3, 4.5, 5, 5.5, 8, 13,
    10, 3, 0, 3.5, 4, 5, 7, 6.5,
    3, 0, 2, 5, 6.5, 5, 7, 9,
    8, 4, 0, 0, 3, 4.5, 5.5, 4,
    5, 7, 8, 6, 8, 7.5, 5, 3,
  ];

  const machineHours = [
    0.5, 0, 3, 4.5, 5.5, 6, 11, 17,
    13, 3.5, 0, 3.5, 4, 5.5, 8.5, 7.5,
    3.5, 0, 2, 5.5, 7.5, 5.5, 9.5, 14,
    11, 5, 0, 0, 3.5, 5, 6.5, 5,
    7, 10, 11, 8, 13, 12, 8, 4,
  ];

  // Compute trailing 5-day ratio, skipping zero-activity days
  const windowSize = 7;
  const ratios: (number | null)[] = [];

  for (let i = 0; i < wallHours.length; i++) {
    if (wallHours[i] === 0 && machineHours[i] === 0) {
      ratios.push(null);
      continue;
    }
    let wallSum = 0;
    let machineSum = 0;
    let count = 0;
    for (let j = i; j >= 0 && count < windowSize; j--) {
      if (wallHours[j] > 0 || machineHours[j] > 0) {
        wallSum += wallHours[j];
        machineSum += machineHours[j];
        count++;
      }
    }
    ratios.push(wallSum > 0 ? Math.round((machineSum / wallSum) * 100) / 100 : null);
  }

  mountThemedChart('machine-wall-ratio-chart', (t) => ({
    type: 'line',
    data: {
      labels,
      datasets: [
        {
          label: 'Machine:Wall Ratio',
          data: ratios,
          borderColor: t.accent,
          backgroundColor: t.alpha(t.accent, 0.1),
          fill: true,
          tension: 0.3,
          pointRadius: 0,
          pointHoverRadius: 3,
          borderWidth: 2,
          spanGaps: true,
        },
        {
          label: 'Baseline (1.0)',
          data: Array(labels.length).fill(1.0),
          borderColor: t.amber,
          borderDash: [6, 4],
          borderWidth: 1,
          pointRadius: 0,
          pointHoverRadius: 0,
          fill: false,
        },
      ],
    },
    options: {
      responsive: true,
      maintainAspectRatio: true,
      aspectRatio: 2.5,
      interaction: {
        intersect: false,
        mode: 'index',
      },
      plugins: {
        legend: {
          position: 'bottom',
          labels: {
            color: t.tick,
            usePointStyle: true,
            pointStyle: 'circle',
            padding: 20,
            font: { size: 12 },
            filter: (item) => item.text !== 'Baseline (1.0)',
          },
        },
        tooltip: {
          filter: (item) => item.dataset.label !== 'Baseline (1.0)',
          callbacks: {
            label: (context) => `${context.dataset.label}: ${context.parsed.y}x`,
          },
        },
      },
      scales: {
        x: {
          grid: { color: t.grid },
          ticks: {
            color: t.tick,
            maxRotation: 0,
            autoSkip: true,
            maxTicksLimit: 10,
            font: { size: 11 },
          },
        },
        y: {
          grid: { color: t.grid },
          ticks: {
            color: t.tick,
            callback: (value) => `${value}x`,
            font: { size: 11 },
          },
          min: 0.8,
          suggestedMax: 2.0,
        },
      },
    },
  }));
</script>
