---
const today = new Date();
---

<footer>
	<p>&copy; {today.getFullYear()} Mark Schaake · <a href="/rss.xml">Subscribe via RSS</a></p>
</footer>

<style>
	footer {
		max-width: 42rem;
		margin: 0 auto;
		padding: 2rem 1.5rem 3rem;
		text-align: center;
		color: var(--color-ink-3);
		font-size: 0.875rem;
	}

	footer p {
		margin: 0;
	}

	footer a {
		color: inherit;
		text-decoration: underline;
		text-decoration-color: var(--color-rule-2);
		text-underline-offset: 0.2em;
		transition: color 0.15s ease;
	}

	footer a:hover {
		color: var(--color-ink);
	}
</style>
